<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  votingd kept alive by launchd. After a restart, races that were being
  submitted are resolved by reading back the server's record, not by
  resubmitting. This does not prevent sleep; see docs/03-launchd.md.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/bin/votingd</string>
    <string>--project-root</string>
    <string>__PROJECT_ROOT__</string>
    <string>--policy</string>
    <string>__POLICY__</string>
    <string>--driver</string>
    <string>__DRIVER__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>__TIMEZONE__</string>
__EXTRA_ENV__
    <!--
      Do not put credentials here (plists are world-readable). The live driver
      reads KEIBA_LOGIN_ID and KEIBA_PASSWORD from the environment.
    -->
  </dict>

  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/var/log/__LABEL__.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/var/log/__LABEL__.err.log</string>
</dict>
</plist>

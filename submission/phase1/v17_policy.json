{
  "schema_version": 1,
  "policy_id": "COMPETITION-2026-V17",
  "status": "frozen_for_implementation",
  "timezone": "Asia/Tokyo",
  "connection_date": "2026-08-29",
  "competition_points_only": true,
  "runtime": {
    "language": "go",
    "version": "1.26.6",
    "go_mod_version": "1.26",
    "toolchain": "go1.26.6",
    "standard_library_first": true
  },
  "interfaces": {
    "status_listen": "127.0.0.1:18766",
    "allow_non_loopback": false,
    "control_socket": "outputs/competition-2026/votingd.sock",
    "control_socket_mode": "0600",
    "state_directory": "outputs/competition-2026",
    "directory_mode": "0700",
    "file_mode": "0600"
  },
  "modes": {
    "default": "READ_ONLY",
    "allowed": [
      "OFFLINE",
      "AUTH_CHECK",
      "READ_ONLY",
      "TEST_ARMED",
      "SHADOW"
    ],
    "production_enabled": false
  },
  "planner": {
    "implementation": "python_subprocess_adapter",
    "python": ".venv/bin/python",
    "plan_command": [
      "scripts/build_competition_vote_plan.py",
      "--race-id"
    ],
    "plan_schema": "configs/schemas/voting_plan_v2.schema.json",
    "policy_table": "configs/generated/policy_table_v17.json",
    "one_file_per_race": true,
    "require_operator_arm": true,
    "canonical_hash": {
      "algorithm": "sha256",
      "scope": "payload",
      "utf8": true,
      "sort_keys": true,
      "compact": true
    }
  },
  "timing": {
    "plan_freeze_seconds_before_post": 360,
    "target_submit_seconds_before_post": 300,
    "hard_cutoff_seconds_before_post": 240,
    "official_cutoff_seconds_before_post": 180,
    "maximum_clock_skew_seconds": 2,
    "verification_initial_wait_seconds": 60,
    "verification_interval_seconds": 30,
    "verification_max_get_attempts": 3,
    "shutdown_grace_seconds": 10
  },
  "http": {
    "connect_timeout_seconds": 5,
    "tls_handshake_timeout_seconds": 5,
    "response_header_timeout_seconds": 10,
    "login_get_request_timeout_seconds": 15,
    "post_request_timeout_seconds": 20,
    "max_response_body_bytes": 1048576,
    "tls_verification_required": true,
    "login_get_max_attempts": 2,
    "login_get_retry_minimum_cutoff_margin_seconds": 90,
    "post_max_attempts": 1
  },
  "token": {
    "official_lifetime_seconds": 300,
    "local_usable_lifetime_seconds": 240,
    "persist": false,
    "log": false
  },
  "submission": {
    "enabled": true,
    "required_environment": {
      "KEIBA_ENABLE_COMPETITION_SUBMISSION": "2026-08-29"
    },
    "max_arms": 36,
    "max_post_requests": 36,
    "max_races": 36,
    "max_races_per_request": 1,
    "max_bets_per_race": 10,
    "max_total_stake": 400000,
    "max_stake_per_race": 20000,
    "max_daily_total_stake": 400000,
    "stake_unit": 100,
    "max_expanded_bet_points": 10,
    "allowed_bet_id_patterns": [
      "^b1_c0_(?:[1-9]|1[0-8])$",
      "^b2_c0_(?:[1-9]|1[0-8])$",
      "^b3_c0_[1-8]_[1-8]$",
      "^b4_c0_(?:[1-9]|1[0-8])_(?:[1-9]|1[0-8])$",
      "^b5_c0_(?:[1-9]|1[0-8])_(?:[1-9]|1[0-8])$",
      "^b6_c0_(?:[1-9]|1[0-8])_(?:[1-9]|1[0-8])$",
      "^b7_c0_(?:[1-9]|1[0-8])_(?:[1-9]|1[0-8])_(?:[1-9]|1[0-8])$",
      "^b8_c0_(?:[1-9]|1[0-8])_(?:[1-9]|1[0-8])_(?:[1-9]|1[0-8])$"
    ],
    "require_sorted_combinations": true,
    "require_empty_precheck": true,
    "allow_overwrite": false,
    "automatic_post_retry": false,
    "require_exact_get_reconciliation": true,
    "kill_switch": "outputs/STOP_VOTING_API"
  },
  "concurrency": {
    "global_max_in_flight_posts": 1,
    "serialize_by_race_id": true,
    "persist_posting_before_network": true,
    "restart_from_posting_is_get_only": true
  },
  "storage": {
    "journal": "outputs/competition-2026/events.jsonl",
    "snapshot": "outputs/competition-2026/snapshot.json",
    "journal_fsync_each_event": true,
    "snapshot_atomic_rename": true,
    "single_writer": true,
    "retention_days_after_competition": 30,
    "automatic_deletion": false
  },
  "redacted_fields": [
    "authorization",
    "access_token",
    "token",
    "password",
    "KEIBA_LOGIN_ID",
    "KEIBA_PASSWORD",
    "KEIBA_DATA_API_KEY"
  ],
  "stop_conditions": [
    "kill switch exists",
    "date or policy mismatch",
    "plan or confirmation hash mismatch",
    "clock skew exceeds limit",
    "hard cutoff reached",
    "existing vote differs from plan",
    "HTTP 429 or 5xx",
    "POST result is ambiguous",
    "response contract is unknown",
    "journal or snapshot integrity failure",
    "any acceptance test is incomplete",
    "policy table hash mismatch",
    "odds snapshot older than 600 seconds before post",
    "sanrentan or sanrenpuku absent when the instruction requires them"
  ]
}
